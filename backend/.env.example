# =============================================================================
# World Cup 2026 AI Predictor — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# ---------- Server ----------
PORT=10000
NODE_ENV=development

# ---------- Frontend (CORS) ----------
# URL of your deployed frontend (e.g. https://your-app.vercel.app)
FRONTEND_URL=http://localhost:5173

# ---------- Supabase ----------
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
# Service-role (secret) key — NEVER expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Anon (public) key — safe for client-side, used in user-scoped clients
SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------- Football-Data.org ----------
# Free API key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your-football-data-api-key

# ---------- Azure AI Foundry ----------
# Connection string from Azure AI Foundry project → Overview → Connection string
AZURE_AI_PROJECT_CONNECTION_STRING=your-azure-ai-project-connection-string
# The deployed agent/assistant ID
AZURE_AGENT_ID=your-azure-agent-id
# Azure OpenAI endpoint (e.g. https://your-resource.openai.azure.com)
AZURE_AI_ENDPOINT=https://your-resource.openai.azure.com
# Azure AI API key (for REST fallback and key-based auth)
AZURE_AI_API_KEY=your-azure-ai-api-key

# ---------- Admin ----------
# Secret token for admin-only sync endpoints (X-Admin-Secret header)
ADMIN_SECRET=change-me-to-a-strong-random-secret
